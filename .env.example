# LLM backend — provider-agnostic (any OpenAI-compatible endpoint). All optional.
# Unset LLM_BASE_URL -> deterministic offline fake LLM, so the app and the full test
# suite run with no key, no network, and no cost.
#
# Local, no key (recommended):  LLM_BASE_URL=http://localhost:11434/v1
#                               LLM_MODEL=llama3.1
#                               (LLM_API_KEY unused)
# Hosted free tier (Groq):      LLM_BASE_URL=https://api.groq.com/openai/v1
#                               LLM_MODEL=llama-3.3-70b-versatile
#                               LLM_API_KEY=<your free key>
LLM_BASE_URL=
LLM_MODEL=llama3.1
LLM_API_KEY=

PORT=3000
DB_PATH=./data.db

# Defensive input cap (chars) applied at the API boundary before any LLM call.
MAX_CONTENT_LENGTH=8000

# Bounded auto-retry for transient LLM failures before -> FAILED (manually retriable).
MAX_AUTO_RETRIES=2

# In-process worker concurrency.
WORKER_CONCURRENCY=2
